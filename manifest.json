{
  "manifest_version": 3,
  "name": "Ochre for Canvas",
  "description": "Dark mode, themes, an improved to-do list, and GPA tools for Canvas LMS. Everything stays on your device.",
  "version": "0.1.0",
  "icons": {
    "16": "icon/icon-16.png",
    "32": "icon/icon-32.png",
    "48": "icon/icon-48.png",
    "128": "icon/icon-128.png"
  },
  "action": {
    "default_icon": {
      "19": "icon/icon-19.png",
      "38": "icon/icon-38.png"
    },
    "default_popup": "html/popup.html",
    "default_title": "Ochre for Canvas"
  },
  "background": {
    "scripts": [
      "js/defaults.js",
      "js/background.js"
    ],
    "service_worker": "js/background.js"
  },
  "options_page": "html/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "css/darkmodecss.js",
        "js/backgrounds.js",
        "js/markdown.js",
        "js/defaults.js",
        "js/storage.js",
        "js/content.js"
      ],
      "css": [
        "css/content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage"
  ],
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "ochre@example.invalid",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
